[resource]
script = ExtResource("1_script")
id = &"nomadic_forge"
display_name = "Göçebe Demirci Ocağı (Nomadic Forge)"
description = "Wagon-mounted bellows and anvil that can be packed onto ox-carts when the clan migrates."
category = 1
allowed_terrains = Array[int]([0, 6])
footprint = Vector2i(2, 3)
max_health = 850
build_time_sec = 28.0
is_nomadic_movable = true
pack_time_sec = 10.0
unpack_time_sec = 12.0
packed_weight = 220.0
relocation_cost_ratio = 0.20
construction_cost = Array[ExtResource("2_amount")]([SubResource("Resource_cost_stone"), SubResource("Resource_cost_iron")])
upkeep_per_minute = Array[ExtResource("2_amount")]([SubResource("Resource_upkeep_coal")])
production_per_minute = Array[ExtResource("2_amount")]([SubResource("Resource_prod_iron"), SubResource("Resource_prod_bullion")])
supply_radius_m = 0.0

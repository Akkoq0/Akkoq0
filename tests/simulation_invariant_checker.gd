class_name SimulationInvariantChecker
extends RefCounted
## Verification layer (rank 4). Audits seasonal snapshots and multi-year history
## generated by `LongHorizonSimulator` to catch `NaN`/`INF`, negative overflows,
## clamp violations, unbounded inflation, deadlocks, and signal/event storms.


class SeasonSnapshot:
	extends RefCounted
	var season_index: int = 0
	var season_type: GameEnums.SeasonType = GameEnums.SeasonType.SPRING
	var food: int = 0
	var kut: float = 0.0
	var ores: Dictionary[StringName, int] = {}
	var jade_authority_multiplier: float = 1.0
	var pasture_coord: Vector2i = Vector2i.ZERO
	var pasture_capacity: float = 100.0
	var pasture_starving: bool = false
	var meat_milk_multiplier: float = 1.0
	var remount_horse_ratio: float = 1.0
	var active_troops: int = 0
	var wounded_pool: int = 0
	var permanent_dead: int = 0
	var veteran_ratio: float = 0.0
	var glory_score: float = 0.0
	var epidemic_active: bool = false
	var cataclysm_type: GameEnums.CataclysmType = GameEnums.CataclysmType.NONE
	var dynasty_trust: Dictionary[StringName, float] = {}
	var dynasty_stances: Dictionary[StringName, GameEnums.DynastyAttitude] = {}
	var coalition_war_active: bool = false
	var council_active: bool = false
	var council_dilemma_pending: bool = false
	var council_income_multiplier: float = 1.0
	var council_speed_multiplier: float = 1.0
	var kinship_stage: GameEnums.IntriguePlotStage = GameEnums.IntriguePlotStage.LOYAL_CALM
	var kinship_loyalty: float = 70.0
	var kinship_grievance: float = 0.0
	var turan_phase: GameEnums.TuranTacticPhase = GameEnums.TuranTacticPhase.RECON_DUST_SCREEN
	var turan_quiver_ammo: float = 100.0
	var turan_fatigue: float = 0.0
	var army_morale: float = 100.0
	var army_cohesion: float = 100.0
	var army_fatigue: float = 0.0
	var army_speed: float = 0.0
	var base_speed: float = 8.0
	var transition_history_size: int = 0
	var cascade_routing: bool = false
	var direct_regions_count: int = 0
	var tax_efficiency_mult: float = 1.0
	var word_reliability: float = 80.0
	var dread_score: float = 0.0
	var honor_score: float = 50.0
	var artisans_count: int = 8
	var active_kurgans: int = 0
	var collapse_state: GameEnums.CollapseState = GameEnums.CollapseState.SOVEREIGN


static func validate_snapshot(snap: SeasonSnapshot, max_ore_cap: int = 250000, max_food_cap: int = 5000) -> PackedStringArray:
	var errors: PackedStringArray = PackedStringArray()
	if snap == null:
		errors.append("Snapshot is null.")
		return errors

	var tag: String = "[Season %d]" % snap.season_index

	# 1. NaN / INF audit on every floating-point metric
	_check_finite(errors, tag, "kut", snap.kut)
	_check_finite(errors, tag, "jade_authority_multiplier", snap.jade_authority_multiplier)
	_check_finite(errors, tag, "pasture_capacity", snap.pasture_capacity)
	_check_finite(errors, tag, "meat_milk_multiplier", snap.meat_milk_multiplier)
	_check_finite(errors, tag, "remount_horse_ratio", snap.remount_horse_ratio)
	_check_finite(errors, tag, "veteran_ratio", snap.veteran_ratio)
	_check_finite(errors, tag, "glory_score", snap.glory_score)
	_check_finite(errors, tag, "council_income_multiplier", snap.council_income_multiplier)
	_check_finite(errors, tag, "council_speed_multiplier", snap.council_speed_multiplier)
	_check_finite(errors, tag, "kinship_loyalty", snap.kinship_loyalty)
	_check_finite(errors, tag, "kinship_grievance", snap.kinship_grievance)
	_check_finite(errors, tag, "turan_quiver_ammo", snap.turan_quiver_ammo)
	_check_finite(errors, tag, "turan_fatigue", snap.turan_fatigue)
	_check_finite(errors, tag, "army_morale", snap.army_morale)
	_check_finite(errors, tag, "army_cohesion", snap.army_cohesion)
	_check_finite(errors, tag, "army_fatigue", snap.army_fatigue)
	_check_finite(errors, tag, "army_speed", snap.army_speed)
	_check_finite(errors, tag, "base_speed", snap.base_speed)
	_check_finite(errors, tag, "tax_efficiency_mult", snap.tax_efficiency_mult)
	_check_finite(errors, tag, "word_reliability", snap.word_reliability)
	_check_finite(errors, tag, "dread_score", snap.dread_score)
	_check_finite(errors, tag, "honor_score", snap.honor_score)

	# 2. Bounds, non-negativity & multiplier clamp guarantees
	if snap.food < 0 or snap.food > max_food_cap:
		errors.append("%s Food out of bounds [0, %d]: %d." % [tag, max_food_cap, snap.food])
	if snap.kut < 0.0 or snap.kut > 100.0:
		errors.append("%s Kut out of bounds [0, 100]: %.3f." % [tag, snap.kut])

	for ore_id: StringName in snap.ores:
		var amount: int = snap.ores[ore_id]
		if amount < 0:
			errors.append("%s Negative ore stockpile for '%s': %d." % [tag, ore_id, amount])
		elif amount > max_ore_cap:
			errors.append("%s Runaway ore inflation for '%s': %d > %d." % [tag, ore_id, amount, max_ore_cap])

	if snap.jade_authority_multiplier < 1.0 or snap.jade_authority_multiplier > 2.0001:
		errors.append("%s Jade authority multiplier violated clamp [1.0, 2.0]: %.4f." % [tag, snap.jade_authority_multiplier])
	if snap.pasture_capacity < 0.0 or snap.pasture_capacity > 100.0001:
		errors.append("%s Pasture capacity out of bounds [0, 100]: %.2f." % [tag, snap.pasture_capacity])
	if snap.meat_milk_multiplier < 0.0 or snap.meat_milk_multiplier > 1.0001:
		errors.append("%s Meat/milk multiplier out of bounds [0, 1]: %.3f." % [tag, snap.meat_milk_multiplier])
	if snap.remount_horse_ratio < 0.0 or snap.remount_horse_ratio > 1.0001:
		errors.append("%s Yılkı remount ratio out of bounds [0, 1]: %.3f." % [tag, snap.remount_horse_ratio])

	if snap.active_troops < 0 or snap.wounded_pool < 0 or snap.permanent_dead < 0:
		errors.append("%s Negative troop counters (%d active, %d wounded, %d dead)." % [
			tag, snap.active_troops, snap.wounded_pool, snap.permanent_dead])
	if snap.veteran_ratio < 0.0 or snap.veteran_ratio > 1.0001:
		errors.append("%s Veteran ratio out of bounds [0, 1]: %.3f." % [tag, snap.veteran_ratio])
	if snap.glory_score < 0.0 or snap.glory_score > 100.0001:
		errors.append("%s Glory score out of bounds [0, 100]: %.3f." % [tag, snap.glory_score])

	if snap.council_income_multiplier < 0.1 or snap.council_income_multiplier > 2.0:
		errors.append("%s Council income multiplier out of bounds [0.1, 2.0]: %.3f." % [tag, snap.council_income_multiplier])
	if snap.council_speed_multiplier < 0.1 or snap.council_speed_multiplier > 2.0:
		errors.append("%s Council speed multiplier out of bounds [0.1, 2.0]: %.3f." % [tag, snap.council_speed_multiplier])

	if snap.kinship_loyalty < 0.0 or snap.kinship_loyalty > 100.0001:
		errors.append("%s Kinship loyalty out of bounds [0, 100]: %.3f." % [tag, snap.kinship_loyalty])
	if snap.kinship_grievance < 0.0 or snap.kinship_grievance > 100.0001:
		errors.append("%s Kinship grievance out of bounds [0, 100]: %.3f." % [tag, snap.kinship_grievance])

	if snap.turan_quiver_ammo < 0.0 or snap.turan_quiver_ammo > 100.0001:
		errors.append("%s Quiver ammo out of bounds [0, 100]: %.3f." % [tag, snap.turan_quiver_ammo])
	if snap.turan_fatigue < 0.0 or snap.turan_fatigue > 100.0001:
		errors.append("%s Turan fatigue out of bounds [0, 100]: %.3f." % [tag, snap.turan_fatigue])
	if snap.army_morale < 0.0 or snap.army_morale > 100.0001:
		errors.append("%s Army morale out of bounds [0, 100]: %.3f." % [tag, snap.army_morale])
	if snap.army_cohesion < 0.0 or snap.army_cohesion > 100.0001:
		errors.append("%s Army cohesion out of bounds [0, 100]: %.3f." % [tag, snap.army_cohesion])
	if snap.army_fatigue < 0.0 or snap.army_fatigue > 100.0001:
		errors.append("%s Army fatigue out of bounds [0, 100]: %.3f." % [tag, snap.army_fatigue])

	if snap.base_speed > 0.0 and snap.army_speed < snap.base_speed * 0.12 - 0.01:
		errors.append("%s Army speed %.3f dropped below 12%% base floor (%.3f)." % [
			tag, snap.army_speed, snap.base_speed * 0.12])

	if snap.direct_regions_count < 0:
		errors.append("%s Negative direct_regions_count: %d." % [tag, snap.direct_regions_count])
	if snap.tax_efficiency_mult < 0.20 or snap.tax_efficiency_mult > 1.5001:
		errors.append("%s Tax efficiency out of bounds [0.20, 1.50]: %.3f." % [tag, snap.tax_efficiency_mult])
	if snap.word_reliability < 0.0 or snap.word_reliability > 100.0001:
		errors.append("%s Word reliability out of bounds [0, 100]: %.3f." % [tag, snap.word_reliability])
	if snap.dread_score < 0.0 or snap.dread_score > 100.0001:
		errors.append("%s Dread score out of bounds [0, 100]: %.3f." % [tag, snap.dread_score])
	if snap.honor_score < 0.0 or snap.honor_score > 100.0001:
		errors.append("%s Honor score out of bounds [0, 100]: %.3f." % [tag, snap.honor_score])
	if snap.artisans_count < 0 or snap.active_kurgans < 0:
		errors.append("%s Negative artisan (%d) or kurgan (%d) count." % [tag, snap.artisans_count, snap.active_kurgans])

	for d_id: StringName in snap.dynasty_trust:
		var trust_val: float = snap.dynasty_trust[d_id]
		_check_finite(errors, tag, "dynasty_trust[%s]" % d_id, trust_val)
		if trust_val < 0.0 or trust_val > 100.0001:
			errors.append("%s Dynasty '%s' trust out of bounds [0, 100]: %.2f." % [tag, d_id, trust_val])

	if snap.transition_history_size > CausalChainEngine.MAX_TRANSITION_HISTORY:
		errors.append("%s Transition history exceeded cap (%d > %d)." % [
			tag, snap.transition_history_size, CausalChainEngine.MAX_TRANSITION_HISTORY])

	# 3. FSM deadlock check: cannot remain stranded in WHISTLING_ARROW_HARASSMENT with 0 ammo
	if snap.turan_phase == GameEnums.TuranTacticPhase.WHISTLING_ARROW_HARASSMENT and snap.turan_quiver_ammo <= 0.0:
		errors.append("%s Turan FSM deadlocked in WHISTLING_ARROW_HARASSMENT at 0 quiver_ammo." % tag)

	return errors


static func validate_history(history: Array[SeasonSnapshot], signal_counts: Dictionary[StringName, int]) -> PackedStringArray:
	var errors: PackedStringArray = PackedStringArray()
	if history.is_empty():
		errors.append("Simulation history is empty.")
		return errors

	var max_storm_threshold: int = maxi(history.size() / 2, 4)
	var council_cnt: int = signal_counts.get(&"council_convened", 0)
	var coalition_cnt: int = signal_counts.get(&"coalition_declared", 0)
	var rebellion_cnt: int = signal_counts.get(&"overgrazing_rebellion", 0)
	var betrayal_cnt: int = signal_counts.get(&"internal_betrayal", 0)

	if council_cnt > max_storm_threshold:
		errors.append("Ak Sakallılar Council convened excessively (%d times across %d seasons)." % [council_cnt, history.size()])
	if coalition_cnt > max_storm_threshold:
		errors.append("Coalition war declared excessively (%d times across %d seasons)." % [coalition_cnt, history.size()])
	if rebellion_cnt > max_storm_threshold:
		errors.append("Overgrazing rebellion fired excessively (%d times across %d seasons)." % [rebellion_cnt, history.size()])
	if betrayal_cnt > max_storm_threshold:
		errors.append("Internal betrayal fired excessively (%d times across %d seasons)." % [betrayal_cnt, history.size()])

	# Detect silent freeze across the entire horizon (food or ores or season never progressed)
	var distinct_seasons: Dictionary[GameEnums.SeasonType, bool] = {}
	for snap: SeasonSnapshot in history:
		distinct_seasons[snap.season_type] = true
	if history.size() >= 4 and distinct_seasons.size() < 4:
		errors.append("Seasonal cycle stalled: observed only %d distinct seasons across %d ticks." % [distinct_seasons.size(), history.size()])

	return errors


static func _check_finite(errors: PackedStringArray, tag: String, field_name: String, val: float) -> void:
	if is_nan(val):
		errors.append("%s NaN detected in '%s'." % [tag, field_name])
	elif is_inf(val):
		errors.append("%s INF detected in '%s'." % [tag, field_name])
